{
  "name": "@revops/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@node-rs/argon2": "2.2.2",
    "@revops/db": "workspace:*",
    "@revops/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@revops/config": "workspace:*",
    "@swc/core": "1.16.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "6.0.3",
    "eslint": "catalog:",
    "postgres": "catalog:",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
