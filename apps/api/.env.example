# API (main.ts) + worker (worker.ts). Overrides the repo-root .env; the DATABASE_* URLs live there.
API_PORT=4000
# Worker: health/ready/metrics server port, and how often the outbox relay polls (ms).
WORKER_PORT=4001
OUTBOX_POLL_INTERVAL_MS=1000
# Web app origin for links in emails (verify email, reset password).
APP_URL=http://localhost:3000
# console = print emails + links to the terminal (dev). fake = in-memory (tests).
# file = one JSON file per email in EMAIL_FILE_DIR (e2e). None is allowed in production.
EMAIL_DRIVER=console
EMAIL_FILE_DIR=.data/mail
EMAIL_FROM=RevOps <no-reply@revops.local>
# Which proxy hops may set X-Forwarded-For: loopback (the web app's /api proxy), false, a hop
# count, or CIDRs. Never `true`.
TRUST_PROXY=loopback
# Keep true: browsers treat http://localhost as a secure context.
COOKIE_SECURE=true
# Key-encryption key for secrets at rest (webhook secrets, later provider tokens): 32 random
# bytes, base64. Optional in dev until you create an API lead source; required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Public form captcha (M2-T2): fake (accepts the token "pass"; dev/tests) | turnstile (Cloudflare,
# needs TURNSTILE_SECRET). Production requires turnstile.
CAPTCHA_DRIVER=fake
TURNSTILE_SECRET=
