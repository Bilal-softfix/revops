# API (main.ts) + worker (worker.ts). Overrides the repo-root .env; DB/Redis URLs live there.
API_PORT=4000
# Web app origin for links in emails (verify email, reset password).
APP_URL=http://localhost:3000
# console = print emails + links to the terminal (dev). fake = in-memory (tests).
EMAIL_DRIVER=console
EMAIL_FROM=RevOps <no-reply@revops.local>
# Keep true: browsers treat http://localhost as a secure context.
COOKIE_SECURE=true
