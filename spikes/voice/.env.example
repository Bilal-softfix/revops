# S1 voice spike — copy to .env.local (gitignored) and fill in. Never commit real values.

# LiveKit Cloud project (free tier): Settings → Keys. Also enables LiveKit Inference
# (combos A and C need no other keys).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Combo B only: https://dashboard.sarvam.ai → API keys.
SARVAM_API_KEY=

# Which pipeline to run: A | B | C (see agent.py COMBOS).
VOICE_COMBO=A

# Optional overrides (defaults in agent.py).
# LLM_MODEL=google/gemma-4-31b-it
# CARTESIA_VOICE=<a Hindi-capable Cartesia voice id>
# SARVAM_SPEAKER=anushka
