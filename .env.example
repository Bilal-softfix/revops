# Shared infrastructure for every Node process (api, worker, db scripts, doctor, tests).
# Copy to `.env` and fill in — see docs/05-local-dev-setup.md. App-specific vars live in apps/<app>/.env.
# Precedence: real environment > apps/<app>/.env > this file. Check with `pnpm run doctor`.
# Local-first (ADR-012): everything runs against a native PostgreSQL 18 — no Redis, no cloud services.

NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# One-off: a superuser on your local Postgres (or Neon's neondb_owner). Only `pnpm run db:bootstrap`
# reads it. `--write-env` fills in the four DATABASE_URL* lines below (here and in apps/api/.env)
# and then deletes this line; later runs use DATABASE_URL_OWNER (verify-only).
DB_BOOTSTRAP_URL=postgresql://postgres:change-me@localhost:5432/postgres?sslmode=disable

# app_user: non-owner, no BYPASSRLS — RLS applies. (On Neon: the -pooler host.)
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/revops_dev?sslmode=disable
# revops_owner: owns the databases, runs migrations. Not a superuser.
DATABASE_URL_OWNER=postgresql://revops_owner:change-me@localhost:5432/revops_dev?sslmode=disable
# Separate test database — name must end in _test (tests truncate tables)
DATABASE_URL_TEST=postgresql://app_user:change-me@localhost:5432/revops_test?sslmode=disable
DATABASE_URL_TEST_OWNER=postgresql://revops_owner:change-me@localhost:5432/revops_test?sslmode=disable

# `pnpm db:seed` — password for the demo users (two demo tenants, see docs/05). Dev data only;
# at least 12 characters.
SEED_PASSWORD=change-me-seed-pw
