# Shared infrastructure for every Node process (api, worker, db scripts, doctor, tests).
# Copy to `.env` and fill in — see docs/05-local-dev-setup.md. App-specific vars live in apps/<app>/.env.
# Precedence: real environment > apps/<app>/.env > this file. Check with `pnpm run doctor`.

NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# One-off: Neon owner role connection string (Neon console → Connect, role neondb_owner).
# Only `pnpm run db:bootstrap` reads it. `--write-env` fills in the four DATABASE_URL* lines below
# (here and in apps/api/.env) and then deletes this line; later runs use DATABASE_URL_OWNER.
NEON_BOOTSTRAP_URL=postgresql://neondb_owner:change-me@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon — app_user (non-owner, RLS enforced), POOLED endpoint
DATABASE_URL=postgresql://app_user:change-me@ep-example-pooler.ap-southeast-1.aws.neon.tech/revops_dev?sslmode=require
# Neon — owner role, DIRECT endpoint (migrations only)
DATABASE_URL_OWNER=postgresql://neondb_owner:change-me@ep-example.ap-southeast-1.aws.neon.tech/revops_dev?sslmode=require
# Separate test database — name must end in _test (tests truncate tables)
DATABASE_URL_TEST=postgresql://app_user:change-me@ep-example-pooler.ap-southeast-1.aws.neon.tech/revops_test?sslmode=require
DATABASE_URL_TEST_OWNER=postgresql://neondb_owner:change-me@ep-example.ap-southeast-1.aws.neon.tech/revops_test?sslmode=require

# Redis Cloud — eviction policy must be noeviction (BullMQ). Use redis:// if TLS is off on your plan.
# Optional until M0-T6: leave blank and doctor only warns. Format:
#   rediss://default:<password>@redis-12345.example.ap-south-1-1.ec2.redns.redis-cloud.com:12345
REDIS_URL=
